# ─────────────────────────────────────────────────────────────────────────────
# AI 汽车运营官 — environment configuration (copy to .env; never commit .env)
# `node src/cli.ts doctor` validates everything below and reports every problem at once.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production. Production refuses simulation data, requires CONSOLE_PASSWORD + SESSION_SECRET
# and a persistent DATABASE_PATH.
APP_ENV=production
HOST=0.0.0.0
PORT=8080
# SQLite file (WAL mode). Back up the .db together with its -wal/-shm files, or use `sqlite3 x.db ".backup"`.
DATABASE_PATH=./data/xhs-operator.db
# Directory for runtime data (defaults to the database directory)
# DATA_DIR=./data
# debug | info | warn | error | silent — JSON lines on stderr
LOG_LEVEL=info

# ── Console access ────────────────────────────────────────────────────────────
# At least 8 characters. Operators log in with their name + this password; names are written to the audit trail.
CONSOLE_PASSWORD=
# At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# External https URL of the console (behind a TLS reverse proxy). Enables Secure cookies in production.
PUBLIC_BASE_URL=
# COOKIE_SECURE=true
# Behind a reverse proxy on this host (nginx → 127.0.0.1): rate-limit logins per real client address (X-Forwarded-For)
# TRUST_PROXY=true

# ── Scheduler (daily workflows per dealer, in the dealer timezone) ────────────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# ── Xiaohongshu data source ───────────────────────────────────────────────────
# none | mcp | simulation (simulation = synthetic corpus for tests/demos; refused when APP_ENV=production)
XHS_PROVIDER=mcp
# xiaohongshu-mcp instance used for public search / note / comment reads
XHS_MCP_RESEARCH_URL=http://127.0.0.1:18060/mcp
# XHS_MCP_RESEARCH_TOKEN=
# One instance per managed account, keyed by the account's platform_account_id from your Dealer Brain bundle.
# Either comma form `id=url,id=url` or JSON `{"id":{"url":"…","token":"…"}}`. Accounts not listed here can use the
# endpoint saved on the 账号 page (xhs_accounts.mcp_endpoint_url) with XHS_MCP_TOKEN.
XHS_MCP_ACCOUNTS=
# Bearer token shared by the instances (AUTH_TOKEN on each xiaohongshu-mcp process)
XHS_MCP_TOKEN=
# Per tool call timeout; every call drives a headless browser
XHS_MCP_TIMEOUT_MS=120000
# Accepted but DM-like tools still stay REQUIRES_REVIEW (no authorized DM API exists)
# XHS_MCP_ENABLE_DM_TOOLS=false

# Simulation (development only)
# XHS_SIM_CORPUS=fixtures/xhs/simulation-corpus.json
# XHS_SIM_REBASE_TO_NOW=true
# XHS_SIM_SEND_MESSAGES=false
# XHS_SIM_RECEIVE_MESSAGES=false
# XHS_SIM_PUBLISH=false
# XHS_SIM_REPLY_COMMENTS=false
# XHS_SIM_AUTH_REQUIRED_ACCOUNTS=
# XHS_SIM_ID_NAMESPACE=

# ── LLM (optional; deterministic engines work without it, LLM output is always validated) ──
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_REFUSAL_FALLBACKS=on

# ── 聚光 私信API对接 lead push webhook (optional) ──────────────────────────────
# At least 16 characters; configure the push URL as https://<console>/webhooks/juguang?token=<token>
JUGUANG_WEBHOOK_TOKEN=
# Dealer that receives pushed leads (dealer id from `node src/cli.ts dealer import`)
JUGUANG_DEFAULT_DEALER_ID=

# ── docker compose only ────────────────────────────────────────────────────────
# XHS_MCP_IMAGE=xpzouying/xiaohongshu-mcp:latest
# APP_PORT=8080
